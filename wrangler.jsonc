{
  "$schema": "https://schema.cloudflare.com/wrangler/config-schema.json",
  "name": "studyfocus-professor-ia",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-11-06",
  // Rate limit: up to 5 voice requests per minute per client IP.
  "ratelimits": [
    {
      "name": "LIMITADOR_DE_FOCO_DE_ESTUDO",
      "namespace_id": "731106",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
